FROM docker.m.daocloud.io/library/python:3.12-slim-bookworm

ARG CAMOUFOX_VERSION=0.4.11
ARG CLOAKBROWSER_VERSION=0.3.31
ARG PLAYWRIGHT_VERSION=1.59.0
ARG PLAYWRIGHT_DOWNLOAD_HOST=https://npmmirror.com/mirrors/playwright
ARG BROWSER_FETCH_PROXY=""

RUN sed -i 's/deb.debian.org/mirrors.ustc.edu.cn/g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        fonts-noto-cjk \
        git \
        libasound2 \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libcairo2 \
        libcups2 \
        libdbus-1-3 \
        libdbus-glib-1-2 \
        libdrm2 \
        libgbm1 \
        libglib2.0-0 \
        libgtk-3-0 \
        libnspr4 \
        libnss3 \
        libpango-1.0-0 \
        libx11-6 \
        libx11-xcb1 \
        libxcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxkbcommon0 \
        libxrandr2 \
        libxt6 \
        tzdata \
        wget \
        xauth \
        xdg-utils \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple \
    && pip install --no-cache-dir \
        "camoufox[geoip]==${CAMOUFOX_VERSION}" \
        "cloakbrowser==${CLOAKBROWSER_VERSION}" \
        "playwright==${PLAYWRIGHT_VERSION}"

RUN if [ -n "$BROWSER_FETCH_PROXY" ]; then \
         HTTP_PROXY="$BROWSER_FETCH_PROXY" HTTPS_PROXY="$BROWSER_FETCH_PROXY" python -m camoufox fetch; \
       else \
         python -m camoufox fetch; \
       fi

RUN if [ -n "$BROWSER_FETCH_PROXY" ]; then \
         HTTP_PROXY="$BROWSER_FETCH_PROXY" HTTPS_PROXY="$BROWSER_FETCH_PROXY" python -m cloakbrowser install; \
       else \
         python -m cloakbrowser install; \
       fi

ENV CLOAKBROWSER_AUTO_UPDATE=false

RUN if PLAYWRIGHT_DOWNLOAD_HOST="$PLAYWRIGHT_DOWNLOAD_HOST" python -m playwright install chromium; then \
         true; \
       elif [ -n "$BROWSER_FETCH_PROXY" ]; then \
         echo "Playwright mirror download failed; retrying via BROWSER_FETCH_PROXY"; \
         unset PLAYWRIGHT_DOWNLOAD_HOST; \
         HTTP_PROXY="$BROWSER_FETCH_PROXY" HTTPS_PROXY="$BROWSER_FETCH_PROXY" python -m playwright install chromium; \
       else \
         exit 1; \
       fi
